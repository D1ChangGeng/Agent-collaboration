diff --git a/src/main/menu/register-app-menu.test.ts b/src/main/menu/register-app-menu.test.ts
new file mode 100644
index 0000000000..2a0cf38ee7
--- /dev/null
+++ b/src/main/menu/register-app-menu.test.ts
@@ -0,0 +1,91 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+const { buildFromTemplateMock, setApplicationMenuMock } = vi.hoisted(() => ({
+  buildFromTemplateMock: vi.fn((template: Electron.MenuItemConstructorOptions[]) => ({ template })),
+  setApplicationMenuMock: vi.fn()
+}))
+
+vi.mock('electron', () => ({
+  BrowserWindow: {
+    getFocusedWindow: vi.fn(() => null)
+  },
+  Menu: {
+    buildFromTemplate: buildFromTemplateMock,
+    setApplicationMenu: setApplicationMenuMock,
+    sendActionToFirstResponder: vi.fn()
+  },
+  MenuItem: vi.fn(function (opts: Electron.MenuItemConstructorOptions) {
+    return opts
+  }),
+  app: {
+    name: 'Porpita',
+    getLocale: vi.fn(() => 'en-US')
+  },
+  webContents: {
+    getFocusedWebContents: vi.fn(() => null)
+  }
+}))
+
+import { setMainUiLanguage } from '../i18n/main-i18n'
+import { registerAppMenu } from './register-app-menu'
+
+function registerDefaultMenu(): Electron.MenuItemConstructorOptions[] {
+  registerAppMenu({
+    onOpenSettings: vi.fn(),
+    onOpenSetupGuide: vi.fn(),
+    onOpenFeatureTour: vi.fn(),
+    onOpenCrashReport: vi.fn(),
+    onCheckForUpdates: vi.fn(),
+    onZoomIn: vi.fn(),
+    onZoomOut: vi.fn(),
+    onZoomReset: vi.fn(),
+    onToggleLeftSidebar: vi.fn(),
+    onToggleRightSidebar: vi.fn(),
+    onToggleAppearance: vi.fn(),
+    getAppearanceState: () => ({
+      showTasksButton: true,
+      showAutomationsButton: true,
+      showMobileButton: true,
+      showTitlebarAppName: true,
+      statusBarVisible: true
+    })
+  })
+  return buildFromTemplateMock.mock.calls.at(-1)?.[0] ?? []
+}
+
+describe('registerAppMenu localization', () => {
+  beforeEach(async () => {
+    buildFromTemplateMock.mockClear()
+    setApplicationMenuMock.mockClear()
+    await setMainUiLanguage('en')
+  })
+
+  it('uses Porpita Help menu labels in English instead of Orca fallbacks', () => {
+    const template = registerDefaultMenu()
+    const helpMenu = template.find((item) => item.label === 'Help')
+    const helpSubmenu = Array.isArray(helpMenu?.submenu) ? helpMenu.submenu : []
+    const labels = helpSubmenu.map((item) => item.label).filter(Boolean)
+
+    expect(labels).toContain('Explore Porpita')
+    expect(labels).toContain('Getting Started with Porpita')
+    expect(labels).not.toContain('Explore Orca')
+    expect(labels).not.toContain('Getting Started with Orca')
+
+    const viewMenu = template.find((item) => item.label === 'View')
+    const viewSubmenu = Array.isArray(viewMenu?.submenu) ? viewMenu.submenu : []
+    const appearanceMenu = viewSubmenu.find((item) => item.label === 'Appearance')
+    const appearanceSubmenu = Array.isArray(appearanceMenu?.submenu) ? appearanceMenu.submenu : []
+    expect(appearanceSubmenu.map((item) => item.label)).toContain('Show Porpita Mobile Button')
+  })
+
+  it('localizes Help menu labels in Simplified Chinese', async () => {
+    await setMainUiLanguage('zh')
+    const template = registerDefaultMenu()
+    const helpMenu = template.find((item) => item.label === '帮助')
+    const helpSubmenu = Array.isArray(helpMenu?.submenu) ? helpMenu.submenu : []
+    const labels = helpSubmenu.map((item) => item.label).filter(Boolean)
+
+    expect(labels).toContain('探索 Porpita')
+    expect(labels).toContain('Porpita 入门')
+  })
+})
