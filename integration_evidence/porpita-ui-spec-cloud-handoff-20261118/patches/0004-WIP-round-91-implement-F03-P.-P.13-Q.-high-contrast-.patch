+describe('UI primitives motion-reduce support', () => {
+  it('adds motion-reduce classes to Dialog, Sheet, Select, CommandDialog, Tooltip, Accordion, and Switch', () => {
+    render(
+      <TooltipProvider>
+        <Dialog open>
+          <DialogContent>
+            <DialogTitle>Confirm action</DialogTitle>
+            <DialogDescription>Check reduced motion</DialogDescription>
+          </DialogContent>
+        </Dialog>
+        <Sheet open>
+          <SheetContent>
+            <SheetTitle>Details</SheetTitle>
+            <SheetDescription>Sheet body</SheetDescription>
+          </SheetContent>
+        </Sheet>
+        <Select open defaultValue="a">
+          <SelectTrigger aria-label="Select demo">
+            <SelectValue />
+          </SelectTrigger>
+          <SelectContent>
+            <SelectItem value="a">Option A</SelectItem>
+          </SelectContent>
+        </Select>
+        <CommandDialog open>
+          <div>Cmd item</div>
+        </CommandDialog>
+        <Tooltip open>
+          <TooltipTrigger asChild>
+            <button type="button">Tip trigger</button>
+          </TooltipTrigger>
+          <TooltipContent>Tooltip body</TooltipContent>
+        </Tooltip>
+        <Accordion type="single" collapsible>
+          <AccordionItem value="item-1">
+            <AccordionTrigger>Accordion title</AccordionTrigger>
+            <AccordionContent>Body</AccordionContent>
+          </AccordionItem>
+        </Accordion>
+        <Switch aria-label="Toggle switch" />
+      </TooltipProvider>
+    )
+
+    const dialogOverlay = document.querySelector("[data-slot='dialog-overlay']")
+    const dialogContent = document.querySelector("[data-slot='dialog-content']")
+    const sheetOverlay = document.querySelector("[data-slot='sheet-overlay']")
+    const sheetContent = document.querySelector("[data-slot='sheet-content']")
+    const selectContent = document.querySelector("[data-slot='select-content']")
+    const commandContent = document.querySelector("[data-slot='command-dialog-content']")
+    const tooltipContent = document.querySelector("[data-slot='tooltip-content']")
+    const accordionTrigger = document.querySelector("[data-slot='accordion-trigger']")
+    const accordionSvg = accordionTrigger?.querySelector('svg')
+    const switchEl = document.querySelector("[data-slot='switch']")
+    const switchThumb = document.querySelector("[data-slot='switch-thumb']")
+
+    expect(dialogOverlay?.className).toContain('motion-reduce:data-[state=open]:animate-none')
+    expect(dialogContent?.className).toContain('motion-reduce:data-[state=open]:animate-none')
+    expect(sheetOverlay?.className).toContain('motion-reduce:data-[state=open]:animate-none')
+    expect(sheetContent?.className).toContain('motion-reduce:transition-none')
+    expect(sheetContent?.className).toContain('motion-reduce:data-[state=open]:animate-none')
+    expect(selectContent?.className).toContain('motion-reduce:data-[state=open]:animate-none')
+    expect(commandContent?.className).toContain('motion-reduce:data-[state=open]:animate-none')
+    expect(tooltipContent?.className).toContain('motion-reduce:animate-none')
+    expect(accordionSvg?.getAttribute('class')).toContain('motion-reduce:transition-none')
