+    const en = JSON.parse(readFileSync(resolve('src/renderer/src/i18n/locales/en.json'), 'utf8'))
+    const zh = JSON.parse(readFileSync(resolve('src/renderer/src/i18n/locales/zh.json'), 'utf8'))
+    const zht = JSON.parse(
+      readFileSync(resolve('src/renderer/src/i18n/locales/zh-Hant.json'), 'utf8')
+    )
+    const flatten = (obj: Record<string, unknown>, prefix = ''): Record<string, string> => {
+      const out: Record<string, string> = {}
+      for (const [k, v] of Object.entries(obj)) {
+        const p = prefix ? `${prefix}.${k}` : k
+        if (v && typeof v === 'object' && !Array.isArray(v)) {
+          Object.assign(out, flatten(v as Record<string, unknown>, p))
+        } else if (typeof v === 'string') {
+          out[p] = v
+        }
+      }
+      return out
+    }
+    const fen = flatten(en)
+    const fzh = flatten(zh)
+    const fzht = flatten(zht)
+    const prefixes = [
+      'settings.appearance.',
+      'settings.windowMaterial.',
+      'auto.components.settings.Appearance'
+    ]
+    for (const key of Object.keys(fen)) {
+      if (prefixes.some((p) => key.startsWith(p))) {
+        expect(fzh, `zh.json missing ${key}`).toHaveProperty(key)
+        expect(fzht, `zh-Hant.json missing ${key}`).toHaveProperty(key)
+      }
+    }
+    expect(fen['settings.appearance.menuBarIcon.description']).not.toContain('an Porpita')
+    expect(fen['settings.appearance.menuBarIcon.description']).toContain('a Porpita')
+
+    // Verify F03-owned fallbacks contain no Orca copy leaks
+    for (const rel of [
+      'src/renderer/src/components/settings/page/settings-interface-primary-section-renderers.tsx',
+      'src/renderer/src/components/settings/appearance/AppearanceInterfaceSection.tsx',
+      'src/renderer/src/components/settings/appearance/WindowMaterialSetting.tsx',
+      'src/renderer/src/components/settings/appearance/appearance-status-bar-search.ts',
+      'src/renderer/src/app-shell/AppWorkspaceShell.tsx',
+      'src/renderer/src/main.tsx'
+    ]) {
+      const text = readFileSync(resolve(rel), 'utf8')
+      expect(text, `${rel} still contains Orca copy`).not.toMatch(/['"`][^'"`]*\bOrca\b[^'"`]*['"`]/)
+    }
+  })
+})
