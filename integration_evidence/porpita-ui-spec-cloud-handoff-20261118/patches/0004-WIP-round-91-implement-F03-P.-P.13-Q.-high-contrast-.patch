+    --ring: #171717;
+    --sidebar-border: #737373;
+    --sidebar-ring: #171717;
+    --worktree-sidebar-border: #737373;
+    --worktree-sidebar-ring: #171717;
+    --split-divider: #525252;
+    --split-divider-hover: #171717;
+  }
+
+  .dark {
+    --orca-security-border: rgb(255 255 255 / 0.34);
+    --orca-security-input: rgb(255 255 255 / 0.42);
+    --orca-security-ring: #e5e5e5;
+    --border: rgb(255 255 255 / 0.34);
+    --input: rgb(255 255 255 / 0.42);
+    --ring: #e5e5e5;
+    --sidebar-border: rgb(255 255 255 / 0.34);
+    --sidebar-ring: #e5e5e5;
+    --worktree-sidebar-border: rgb(255 255 255 / 0.34);
+    --worktree-sidebar-ring: #e5e5e5;
+    --split-divider: #a1a1aa;
+    --split-divider-hover: #f0f0f0;
+  }
+}
+
+@media (forced-colors: active) {
+  :is(
+    button,
+    [role='button'],
+    [role='radio'],
+    [role='tab'],
+    [role='menuitem'],
+    [role='option'],
+    [role='switch'],
+    a,
+    input,
+    textarea,
+    select,
+    [tabindex],
+    .tab-group-split-resize-handle,
+    .worktree-agent-send-target-button
+  ):focus-visible {
+    outline: 2px solid Highlight;
+    outline-offset: 2px;
+  }
+
+  .tab-group-split-resize-handle:focus-visible,
+  [data-testid='sortable-tab']:focus-visible {
+    outline: 2px solid Highlight;
+    outline-offset: -2px;
+  }
+
+  [data-slot='command-item'].jump-palette-item[data-selected='true'],
+  [role='option'].jump-palette-item[data-selected='true'],
+  .jump-palette-command [data-slot='command-item'][data-selected='true'],
+  .jump-palette-command [role='option'][data-selected='true'],
+  .ai-vault-session-row[data-selected='true'],
+  .plugin-list-row:has([data-plugin-row-name]:focus-visible),
+  [data-file-explorer-row][data-selected='true'],
+  [data-worktree-card-surface][data-worktree-card-active='primary'],
+  [data-worktree-card-surface][data-worktree-card-active='secondary'],
+  [data-worktree-card-surface][data-worktree-card-selected] {
+    border: 1px solid Highlight;
+    outline: 1px solid Highlight;
+    outline-offset: -1px;
+  }
+
+  [data-current='true'],
+  [aria-current='page'],
+  [data-testid='sortable-tab'][data-active='true'] {
+    outline: 1px solid Highlight;
+    outline-offset: -1px;
+  }
+
+  [data-slot='switch'],
+  [data-slot='switch-indicator'] {
+    border: 1px solid ButtonText;
+  }
+
+  [data-slot='switch'][data-state='checked'],
+  [data-slot='switch-indicator'][data-state='checked'] {
+    background-color: Highlight;
+    border-color: Highlight;
+  }
+
+  [data-slot='switch-thumb'] {
+    background-color: ButtonText;
+    border: 1px solid ButtonText;
+  }
+
+  [data-state='checked'] > [data-slot='switch-thumb'] {
+    background-color: HighlightText;
+    border-color: HighlightText;
+  }
+
+  .tab-group-split-resize-handle::after,
+  .pane-divider::after,
+  [data-slot='separator'] {
+    background-color: CanvasText;
+  }
+
+  .tab-group-split-resize-handle:hover::after,
+  .tab-group-split-resize-handle:focus-visible::after,
+  .pane-divider:hover::after {
+    background-color: Highlight;
+  }
+}
