+        id="interface"
+        icon={<span>I</span>}
+        title="Interface"
+        summary="Summary"
+        open={false}
+        onToggle={vi.fn()}
+      >
+        <div>Child</div>
+      </AppearanceSection>
+    )
+    const chevron = container.querySelector('svg')
+    expect(chevron?.getAttribute('class')).toContain('motion-reduce:transition-none')
