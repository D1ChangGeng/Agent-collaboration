diff --git a/src/renderer/src/assets/main-css-accessibility-motion.test.ts b/src/renderer/src/assets/main-css-accessibility-motion.test.ts
new file mode 100644
index 0000000000..b81d08e4ff
--- /dev/null
+++ b/src/renderer/src/assets/main-css-accessibility-motion.test.ts
@@ -0,0 +1,104 @@
+import { readFileSync } from 'node:fs'
+import { describe, expect, it } from 'vitest'
+
+const readAsset = (name: string): string =>
+  readFileSync(new URL(`./${name}`, import.meta.url), 'utf8')
+
+const mainCss = readAsset('main.css')
+const markdownPreviewCss = readAsset('markdown-preview.css')
+const richMarkdownEditorCss = readAsset('rich-markdown-editor.css')
+const mobilePageCss = readAsset('mobile-page.css')
+const terminalCss = readAsset('terminal.css')
+
+describe('main.css high contrast and forced-colors rules', () => {
+  it('strengthens hairline, ring, and divider tokens under prefers-contrast: more', () => {
+    const match = mainCss.match(/@media \(prefers-contrast: more\)\s*\{[\s\S]*?\n\}/)
+    expect(match).not.toBeNull()
+    const block = match![0]
+    for (const token of [
+      '--border',
+      '--input',
+      '--ring',
+      '--sidebar-border',
+      '--worktree-sidebar-border',
+      '--worktree-sidebar-ring',
+      '--split-divider'
+    ]) {
+      expect(block).toContain(token)
+    }
+  })
+
+  it('adds forced-colors: active rules for focus-visible, selected rows, switch, and dividers', () => {
+    const match = mainCss.match(/@media \(forced-colors: active\)\s*\{[\s\S]*?\n\}/)
+    expect(match).not.toBeNull()
+    const block = match![0]
+    for (const selector of [
+      ':focus-visible',
+      ".jump-palette-item[data-selected='true']",
+      "[data-file-explorer-row][data-selected='true']",
+      "[data-worktree-card-surface][data-worktree-card-active='primary']",
+      "[data-current='true']",
+      "[data-slot='switch']",
+      '.tab-group-split-resize-handle::after',
+      '.pane-divider::after',
+      "[data-slot='separator']"
+    ]) {
+      expect(block).toContain(selector)
+    }
+    expect(block).toContain('Highlight')
+    expect(block).toContain('CanvasText')
+  })
+})
+
+describe('CSS prefers-reduced-motion rules', () => {
+  it('avoids destructive global wildcard animation-duration: 0ms overrides', () => {
+    expect(mainCss).not.toMatch(/\*\s*\{[^}]*animation-duration\s*:\s*0m?s\s*!important/)
+  })
+
+  it('covers shell, sheet, sidebar, update card, waveform, copy toast, drop indicator, and feature-wall rules', () => {
+    const blocks = [...mainCss.matchAll(/@media \(prefers-reduced-motion: reduce\)\s*\{[\s\S]*?\n\}/g)]
+      .map((m) => m[0])
+      .join('\n')
+    for (const selector of [
+      '.settings-view-shell',
+      ".workspace-kanban-sheet-content[data-state='open']",
+      ".workspace-kanban-sheet-content[data-state='closed']",
+      '.sidebar',
+      '.animate-update-card-enter',
+      '.animate-update-card-exit',
+      '.animate-waveform',
+      '.editor-header-copy-toast',
+      "[data-workspace-board-card-drop-indicator='true']",
+      '.feature-wall-marquee-track',
+      '.feature-wall-click-ring',
+      '.feature-wall-meta-pulse'
+    ]) {
+      expect(blocks).toContain(selector)
+    }
+  })
+
+  it('covers markdown-preview, rich-markdown-editor, mobile-page, and terminal reduced-motion rules', () => {
+    expect(markdownPreviewCss).toContain('@media (prefers-reduced-motion: reduce)')
+    expect(markdownPreviewCss).toContain('.markdown-annotation-card.is-attention')
+
+    expect(richMarkdownEditorCss).toContain('@media (prefers-reduced-motion: reduce)')
+    expect(richMarkdownEditorCss).toContain('.rich-markdown-annotation-selection-active')
+    expect(richMarkdownEditorCss).toContain('.rich-markdown-review-note-card.is-attention')
+
+    const mobileReduced = mobilePageCss.match(
+      /@media \(prefers-reduced-motion: reduce\)\s*\{[\s\S]*?\n\}/
+    )
+    expect(mobileReduced).not.toBeNull()
+    expect(mobileReduced![0]).toContain('.mp-network-refresh.is-spinning')
+    expect(mobileReduced![0]).toContain('.is-tapping')
+    expect(mobileReduced![0]).toContain('.mp-wl-spinner')
+    expect(mobileReduced![0]).toContain('.mp-term-cursor')
+
+    const terminalReduced = terminalCss.match(
+      /@media \(prefers-reduced-motion: reduce\)\s*\{[\s\S]*?\n\}/
+    )
+    expect(terminalReduced).not.toBeNull()
+    expect(terminalReduced![0]).toContain('.pane-divider::after')
+    expect(terminalReduced![0]).toContain('.pane-focus-rim-flash::before')
+  })
+})
