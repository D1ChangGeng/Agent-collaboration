diff --git a/src/renderer/src/components/onboarding/OnboardingFlow.focus-and-l10n.test.tsx b/src/renderer/src/components/onboarding/OnboardingFlow.focus-and-l10n.test.tsx
index 498dd233ef..1986c0c8ae 100644
--- a/src/renderer/src/components/onboarding/OnboardingFlow.focus-and-l10n.test.tsx
+++ b/src/renderer/src/components/onboarding/OnboardingFlow.focus-and-l10n.test.tsx
@@ -242,4 +242,35 @@ describe('OnboardingFlow focus, localization fallbacks, and responsive layout',
       expect(document.activeElement).toBe(setUpLaterButton)
     })
   })
+
+  it('falls back to the onboarding modal instead of document.body if the prior focused control becomes disabled while skip confirmation is open', async () => {
+    const view = render(
+      <OnboardingFlow onboarding={OPEN_ONBOARDING} onOnboardingChange={vi.fn()} />
+    )
+
+    const modal = screen.getByRole('dialog', { name: 'Porpita onboarding' })
+    const backdrop = view.container.querySelector('[data-onboarding-overlay]') as HTMLElement
+    const continueButton = screen.getByRole('button', { name: /Continue/i }) as HTMLButtonElement
+
+    continueButton.focus()
+    expect(document.activeElement).toBe(continueButton)
+
+    fireEvent.pointerDown(backdrop, { target: backdrop })
+    const keepGoingButton = await screen.findByRole('button', { name: 'No, keep going' })
+    const skipDialog = screen.getByRole('dialog', { name: 'Skip onboarding?' })
+    await waitFor(() => {
+      expect(skipDialog.contains(document.activeElement)).toBe(true)
+    })
+
+    continueButton.disabled = true
+
+    const user = userEvent.setup()
+    await user.click(keepGoingButton)
+    await waitFor(() => {
+      expect(screen.queryByRole('dialog', { name: 'Skip onboarding?' })).not.toBeInTheDocument()
+      expect(document.activeElement).not.toBe(document.body)
+      expect(modal.contains(document.activeElement)).toBe(true)
+      expect(document.activeElement).toBe(modal)
+    })
+  })
 })
