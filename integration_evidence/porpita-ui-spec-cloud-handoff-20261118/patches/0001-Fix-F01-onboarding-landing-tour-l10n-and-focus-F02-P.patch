@@ -0,0 +1,63 @@
+// @vitest-environment happy-dom
+
+import '@testing-library/jest-dom/vitest'
+import type { ReactNode } from 'react'
+import { cleanup, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('@/i18n/i18n', () => ({
+  getIntlLocale: () => 'en-US',
+  translate: (_key: string, fallback: string) => fallback
+}))
+
+vi.mock('@/components/ui/tooltip', () => ({
+  Tooltip: ({ children }: { children: ReactNode }) => <>{children}</>,
+  TooltipContent: ({ children }: { children: ReactNode }) => <div>{children}</div>,
+  TooltipTrigger: ({ children }: { children: ReactNode }) => <>{children}</>
+}))
+
+vi.mock('./mobile-platform-copy', () => ({
+  mobilePairingCopy: () => ({ openApp: 'Open Porpita Mobile' })
+}))
+
+import { MobilePageToolbar } from './MobilePageToolbar'
+import { HeroPaired } from './MobileHeroPairedDevices'
+import { HomeSlide } from './slides/HomeSlide'
+
+describe('Porpita Mobile M.01 copy and Porpita branding fallbacks', () => {
+  afterEach(cleanup)
+
+  it('uses Porpita Mobile accessible labels and copy instead of Orca Mobile', () => {
+    render(
+      <>
+        <MobilePageToolbar
+          showMobileButton
+          onClose={vi.fn()}
+          onToggleMobileSidebarButton={vi.fn()}
+        />
+        <HeroPaired
+          devices={[
+            {
+              deviceId: 'dev-1',
+              name: 'Pixel',
+              pairedAt: 1_754_000_000_000,
+              lastSeenAt: 1_754_000_100_000
+            }
+          ]}
+          onPairAnother={vi.fn()}
+          onRevoke={vi.fn()}
+          revokingDeviceIds={[]}
+        />
+        <HomeSlide tapping={false} />
+      </>
+    )
+
+    expect(screen.getByRole('button', { name: 'Close Porpita Mobile' })).toBeInTheDocument()
+    expect(screen.getByText('Porpita Mobile')).toBeInTheDocument()
+    expect(
+      screen.getByText('Open Porpita Mobile to pick up where you left off, or pair another device.')
+    ).toBeInTheDocument()
+    expect(screen.getByText('Porpita')).toBeInTheDocument()
+    expect(screen.queryByText(/Orca Mobile/)).not.toBeInTheDocument()
+  })
+})
