diff --git a/src/renderer/src/components/sidebar/SidebarNav.test.tsx b/src/renderer/src/components/sidebar/SidebarNav.test.tsx
new file mode 100644
index 0000000000..f4f10e5e0a
--- /dev/null
+++ b/src/renderer/src/components/sidebar/SidebarNav.test.tsx
@@ -0,0 +1,124 @@
+// @vitest-environment happy-dom
+
+import '@testing-library/jest-dom/vitest'
+import type { ReactNode } from 'react'
+import { cleanup, render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+type StoreState = {
+  openAutomationsPage: () => void
+  openMobilePage: () => void
+  openArtifactsPage: () => void
+  openSkillsPage: () => void
+  openModal: (modal: string) => void
+  updateSettings: (updates: Record<string, unknown>) => Promise<void>
+  activeView: string
+  settings: {
+    showAutomationsButton?: boolean
+    showMobileButton?: boolean
+    showArtifactsButton?: boolean
+    showSkillsButton?: boolean
+    experimentalAgentDashboardPopout?: boolean
+  }
+}
+
+const mocks = vi.hoisted(() => ({
+  dismissBadge: vi.fn(),
+  storeState: {} as StoreState
+}))
+
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({ t: (k: string) => k })
+}))
+
+vi.mock('@/store', () => ({
+  useAppStore: (selector: (state: StoreState) => unknown) => selector(mocks.storeState)
+}))
+
+vi.mock('@/hooks/useShortcutLabel', () => ({
+  useShortcutKeyComboDetails: () => []
+}))
+
+vi.mock('@/i18n/i18n', () => ({
+  translate: (_key: string, fallback: string) => fallback
+}))
+
+vi.mock('./mobile-sidebar-onboarding-badge', () => ({
+  useMobileSidebarOnboardingBadge: () => ({
+    visible: false,
+    hasPairedDevice: false,
+    dismiss: mocks.dismissBadge
+  })
+}))
+
+vi.mock('@/components/ui/context-menu', () => ({
+  ContextMenu: ({ children }: { children: ReactNode }) => <>{children}</>,
+  ContextMenuTrigger: ({ children }: { children: ReactNode }) => <>{children}</>
+}))
+
+vi.mock('@/components/ui/tooltip', () => ({
+  Tooltip: ({ children }: { children: ReactNode }) => <>{children}</>,
+  TooltipContent: ({ children }: { children: ReactNode }) => <div>{children}</div>,
+  TooltipTrigger: ({ children }: { children: ReactNode }) => <>{children}</>
+}))
+
+vi.mock('./SetupGuideSidebarEntry', () => ({
+  SetupGuideSidebarEntry: () => null
+}))
+
+vi.mock('./SidebarTaskNavButton', () => ({
+  SidebarTaskNavButton: () => null
+}))
+
+vi.mock('./sidebar-nav-controls', () => ({
+  HideSidebarMenu: () => null
+}))
+
+vi.mock('../workspace-preview/workspace-preview-visibility', () => ({
+  useWorkspacePreviewVisibility: { getState: () => ({ setOpen: vi.fn() }) },
+  workspacePreviewEnabled: false
+}))
+
+import SidebarNav from './SidebarNav'
+
+describe('SidebarNav', () => {
+  beforeEach(() => {
+    mocks.dismissBadge.mockReset()
+    mocks.storeState = {
+      openAutomationsPage: vi.fn(),
+      openMobilePage: vi.fn(),
+      openArtifactsPage: vi.fn(),
+      openSkillsPage: vi.fn(),
+      openModal: vi.fn(),
+      updateSettings: vi.fn().mockResolvedValue(undefined),
+      activeView: 'terminal',
+      settings: {
+        showAutomationsButton: true,
+        showMobileButton: true
+      }
+    }
+  })
+
+  afterEach(cleanup)
+
+  it('renders Porpita Mobile instead of Orca Mobile in English fallback mode', async () => {
+    const user = userEvent.setup()
+    render(<SidebarNav />)
+
+    const mobileButton = screen.getByRole('button', { name: 'Porpita Mobile' })
+    expect(mobileButton).toBeInTheDocument()
+    expect(screen.queryByText('Orca Mobile')).not.toBeInTheDocument()
+
+    await user.click(mobileButton)
+    expect(mocks.dismissBadge).toHaveBeenCalledOnce()
+    expect(mocks.storeState.openMobilePage).toHaveBeenCalledOnce()
+  })
+
+  it('hides the Porpita Mobile shortcut when showMobileButton is false', () => {
+    mocks.storeState.settings.showMobileButton = false
+    render(<SidebarNav />)
+
+    expect(screen.queryByRole('button', { name: 'Porpita Mobile' })).not.toBeInTheDocument()
+  })
+})
