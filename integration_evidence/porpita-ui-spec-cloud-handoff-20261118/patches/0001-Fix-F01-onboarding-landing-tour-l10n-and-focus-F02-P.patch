+// @vitest-environment happy-dom
+
+import '@testing-library/jest-dom/vitest'
+import { useRef } from 'react'
+import { act, cleanup, render } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { ContextualTourId } from '../../../../shared/contextual-tours'
+
+const mocks = vi.hoisted(() => ({
+  hasVisibleOverlay: vi.fn(() => false)
+}))
+
+vi.mock('@/lib/visible-overlay', () => ({
+  hasVisibleOverlay: mocks.hasVisibleOverlay
+}))
+
+import { hasContextualTourTarget } from './contextual-tour-gate'
+import { useContextualTourFocus } from './use-contextual-tour-focus'
+
+function TourHarness({
+  tourId,
+  stepIndex = 0,
+  rendered = true
+}: {
+  tourId: ContextualTourId | null
+  stepIndex?: number
+  rendered?: boolean
+}): React.JSX.Element {
+  const panelRef = useRef<HTMLDivElement | null>(null)
+  useContextualTourFocus({
+    activeTourId: tourId,
+    activeStepIndex: stepIndex,
+    rendered,
+    panelRef
+  })
+  return (
+    <div ref={panelRef} tabIndex={-1} data-testid="tour-panel">
+      <button type="button" data-testid="tour-action">
+        Next
+      </button>
+    </div>
+  )
+}
+
+describe('useContextualTourFocus', () => {
+  beforeEach(() => {
+    vi.useFakeTimers()
+    mocks.hasVisibleOverlay.mockReset().mockReturnValue(false)
+  })
+
+  afterEach(() => {
+    vi.useRealTimers()
+    cleanup()
+  })
+
+  it('restores focus to the triggering element when the tour unmounts immediately on dismissal', () => {
+    const trigger = document.createElement('button')
+    trigger.textContent = 'Trigger'
+    document.body.appendChild(trigger)
+    trigger.focus()
+    expect(document.activeElement).toBe(trigger)
+
+    const { unmount } = render(<TourHarness tourId="tasks" />)
+
+    act(() => {
+      vi.runAllTimers()
+    })
+    expect(document.activeElement).toHaveAttribute('data-testid', 'tour-action')
+
+    unmount()
+    expect(document.activeElement).toBe(trigger)
+    trigger.remove()
+  })
+
+  it('does not steal focus on unmount if focus moved to an unrelated external control', () => {
+    const trigger = document.createElement('button')
+    const external = document.createElement('button')
+    document.body.append(trigger, external)
+    trigger.focus()
+
+    const { unmount } = render(<TourHarness tourId="tasks" />)
+    act(() => {
+      vi.runAllTimers()
+    })
+
+    external.focus()
+    expect(document.activeElement).toBe(external)
+
+    unmount()
+    expect(document.activeElement).toBe(external)
+    trigger.remove()
+    external.remove()
+  })
+
+  it('does not focus or steal focus for preserveFocus tours', () => {
+    const editor = document.createElement('textarea')
+    document.body.appendChild(editor)
+    editor.focus()
+
+    const { unmount } = render(<TourHarness tourId="projects-collapse-all" />)
+    act(() => {
+      vi.runAllTimers()
+    })
+
+    expect(document.activeElement).toBe(editor)
+    unmount()
+    expect(document.activeElement).toBe(editor)
+    editor.remove()
+  })
+})
+
+describe('hasContextualTourTarget bounds visibility', () => {
+  afterEach(cleanup)
+
+  it('rejects off-screen and overflow-clipped targets while accepting visible targets', () => {
+    Object.defineProperty(window, 'innerWidth', { configurable: true, value: 600 })
+    Object.defineProperty(window, 'innerHeight', { configurable: true, value: 400 })
+
+    const container = document.createElement('div')
+    container.style.overflow = 'hidden'
+    Object.defineProperty(container, 'getBoundingClientRect', {
+      configurable: true,
+      value: () => ({ left: 0, top: 0, right: 200, bottom: 200, width: 200, height: 200 })
+    })
+
+    const clipped = document.createElement('div')
+    clipped.setAttribute('data-contextual-tour-target', 'clipped-target')
+    Object.defineProperty(clipped, 'getBoundingClientRect', {
+      configurable: true,
+      value: () => ({ left: 260, top: 10, right: 320, bottom: 50, width: 60, height: 40 })
+    })
+
+    const offscreen = document.createElement('div')
+    offscreen.setAttribute('data-contextual-tour-target', 'offscreen-target')
+    Object.defineProperty(offscreen, 'getBoundingClientRect', {
+      configurable: true,
+      value: () => ({ left: 650, top: 20, right: 720, bottom: 60, width: 70, height: 40 })
+    })
+
+    const visible = document.createElement('div')
+    visible.setAttribute('data-contextual-tour-target', 'visible-target')
+    Object.defineProperty(visible, 'getBoundingClientRect', {
+      configurable: true,
+      value: () => ({ left: 20, top: 20, right: 120, bottom: 60, width: 100, height: 40 })
+    })
+
+    container.appendChild(clipped)
+    document.body.append(container, offscreen, visible)
+
+    expect(hasContextualTourTarget('[data-contextual-tour-target="clipped-target"]')).toBe(false)
+    expect(hasContextualTourTarget('[data-contextual-tour-target="offscreen-target"]')).toBe(false)
+    expect(hasContextualTourTarget('[data-contextual-tour-target="visible-target"]')).toBe(true)
+
+    container.remove()
+    offscreen.remove()
+    visible.remove()
+  })
+})
