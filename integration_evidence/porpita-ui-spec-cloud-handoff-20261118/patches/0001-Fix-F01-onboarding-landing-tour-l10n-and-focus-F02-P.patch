new file mode 100644
index 0000000000..28d62514f9
--- /dev/null
+++ b/src/renderer/src/components/Landing.test.tsx
@@ -0,0 +1,83 @@
+// @vitest-environment happy-dom
+
+import '@testing-library/jest-dom/vitest'
+import { cleanup, render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const mocks = vi.hoisted(() => ({
+  openModal: vi.fn(),
+  repos: [] as Record<string, unknown>[]
+}))
+
+vi.mock('@/store', () => ({
+  useAppStore: (selector: (state: Record<string, unknown>) => unknown) =>
+    selector({
+      repos: mocks.repos,
+      openModal: mocks.openModal
+    })
+}))
+
+vi.mock('@/i18n/i18n', () => ({
+  translate: (_key: string, fallback: string) => fallback
+}))
+
+vi.mock('@/hooks/useShortcutLabel', () => ({
+  useShortcutKeyDetails: () => ({ keys: ['Ctrl', 'K'], doubleTap: false })
+}))
+
+vi.mock('./landing-preflight-runtime', () => ({
+  useLandingPreflightRuntime: () => ({ preflightIssues: [] })
+}))
+
+vi.mock('./landing-preflight-dismissal', () => ({
+  dismissPreflightIssue: vi.fn(),
+  githubProjectKeys: () => [],
+  isPreflightIssueDismissed: () => false
+}))
+
+vi.mock('@/lib/browser/navigation/app-http-link-open', () => ({
+  openAppHttpLink: vi.fn()
+}))
+
+import Landing from './Landing'
+
+describe('Landing', () => {
+  beforeEach(() => {
+    mocks.openModal.mockReset()
+    mocks.repos = []
+  })
+
+  afterEach(cleanup)
+
+  it('renders Porpita brand copy and vertically scrollable centered container for short viewports', () => {
+    const { container } = render(<Landing />)
+
+    expect(screen.getByRole('heading', { name: 'Porpita' })).toBeInTheDocument()
+    expect(screen.getByAltText('Porpita logo')).toBeInTheDocument()
+    expect(screen.queryByAltText('Orca logo')).not.toBeInTheDocument()
+
+    const scrollHost = container.firstElementChild
+    expect(scrollHost).toHaveClass('overflow-y-auto')
+    expect(scrollHost?.firstElementChild).toHaveClass('m-auto')
+  })
+
+  it('uses focusable Button primitives for primary workspace CTAs', async () => {
+    const user = userEvent.setup()
+    render(<Landing />)
+
+    const addProjectBtn = screen.getByRole('button', { name: 'Add project' })
+    const createWorkspaceBtn = screen.getByRole('button', { name: 'Create workspace' })
+
+    expect(addProjectBtn).toHaveAttribute('data-slot', 'button')
+    expect(createWorkspaceBtn).toHaveAttribute('data-slot', 'button')
+
+    await user.click(addProjectBtn)
+    expect(mocks.openModal).toHaveBeenCalledWith('add-repo')
+
+    await user.click(createWorkspaceBtn)
+    expect(mocks.openModal).toHaveBeenCalledWith('new-workspace-composer', {
+      telemetrySource: 'unknown'
+    })
+  })
+})
