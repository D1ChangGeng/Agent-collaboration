+// @vitest-environment happy-dom
+
+import '@testing-library/jest-dom/vitest'
+import type { ReactNode } from 'react'
+import { cleanup, render, screen, waitFor } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const mocks = vi.hoisted(() => ({
+  next: vi.fn(),
+  setUpLater: vi.fn(),
+  dismissOnboarding: vi.fn(),
+  back: vi.fn(),
+  jumpToStep: vi.fn()
+}))
+
+vi.mock('@/i18n/i18n', () => ({
+  translate: (_key: string, fallback: string) => fallback
+}))
+
+vi.mock('@/lib/app-keyboard-router', () => ({
+  addAppKeyListener: vi.fn(),
+  removeAppKeyListener: vi.fn()
+}))
+
+vi.mock('@/lib/use-scroll-edge-fades', () => ({
+  useScrollEdgeFades: () => ({
+    scrollRef: { current: null },
+    canScrollUp: false,
+    canScrollDown: false,
+    updateScrollFades: vi.fn()
+  })
+}))
+
+vi.mock('@/components/ui/tooltip', () => ({
+  Tooltip: ({ children }: { children: ReactNode }) => <>{children}</>,
+  TooltipProvider: ({ children }: { children: ReactNode }) => <>{children}</>,
+  TooltipTrigger: ({ children }: { children: ReactNode }) => <>{children}</>,
+  TooltipContent: ({ children }: { children: ReactNode }) => <div>{children}</div>
+}))
+
+vi.mock('./OnboardingLanguageSwitcher', () => ({
+  OnboardingLanguageSwitcher: ({ onOpenChange }: { onOpenChange?: (open: boolean) => void }) => (
+    <button type="button" onClick={() => onOpenChange?.(false)}>
+      Switch language
+    </button>
+  )
+}))
+
+vi.mock('./AgentSurfaceStep', () => ({
+  AgentSurfaceStep: () => (
+    <div>
+      <button type="button">Chat UI</button>
+      <button type="button">Terminal</button>
+    </div>
+  )
+}))
+
+vi.mock('./AgentStep', () => ({ AgentStep: () => <div>AgentStep</div> }))
+vi.mock('./ThemeStep', () => ({ ThemeStep: () => <div>ThemeStep</div> }))
+vi.mock('./NotificationStep', () => ({ NotificationStep: () => <div>NotificationStep</div> }))
+vi.mock('./IntegrationsStep', () => ({ IntegrationsStep: () => <div>IntegrationsStep</div> }))
+vi.mock('./WindowsTerminalStep', () => ({
+  WindowsTerminalStep: () => <div>WindowsTerminalStep</div>
+}))
+
+vi.mock('./use-onboarding-flow', () => ({
+  useOnboardingFlow: () => ({
+    settings: null,
+    updateSettings: vi.fn(),
+    stepIndex: 0,
+    progressSteps: [
+      { step: { id: 'agent_surface' }, index: 0 },
+      { step: { id: 'agent' }, index: 1 },
+      { step: { id: 'theme' }, index: 2 }
+    ],
+    progressStepIndex: 0,
+    currentStep: { id: 'agent_surface' },
+    agentSurface: 'chat',
+    setAgentSurface: vi.fn(),
+    chatAgents: [],
+    chatDetected: false,
+    selectedAgent: null,
+    setSelectedAgent: vi.fn(),
+    yoloPermissions: false,
+    setYoloPermissions: vi.fn(),
+    theme: { dark: 'dark', light: 'light', themeMode: 'system' },
+    setTheme: vi.fn(),
+    themeLookBaseline: 'system',
+    setThemeLookBaseline: vi.fn(),
+    busyLabel: null,
+    hasSelectedWorkspace: false,
+    detectedSet: new Set(),
+    isDetectingAgents: false,
+    next: mocks.next,
+    setUpLater: mocks.setUpLater,
+    dismissOnboarding: mocks.dismissOnboarding,
+    back: mocks.back,
+    jumpToStep: mocks.jumpToStep,
+    setLifecycleRootRef: vi.fn()
+  })
+}))
+
+import type { OnboardingState } from '../../../../shared/onboarding-state-types'
+import OnboardingFlow from './OnboardingFlow'
+import { ThemeModeTiles } from './ThemeModeTiles'
+
+const OPEN_ONBOARDING: OnboardingState = {
+  flowVersion: 2,
+  closedAt: null,
+  outcome: null,
+  lastCompletedStep: -1,
+  checklist: {
+    addedRepo: false,
+    choseAgent: false,
+    ranFirstAgent: false,
+    ranSecondAgentOnSameTask: false,
+    triedCmdJ: false,
+    shapedSidebar: false,
+    reviewedDiff: false,
+    openedPr: false,
+    addedFolder: false,
+    openedFile: false,
+    ranAgentOnFile: false,
+    dismissed: false
+  }
+}
+
+describe('OnboardingFlow focus, localization fallbacks, and responsive layout', () => {
+  beforeEach(() => {
+    mocks.next.mockReset()
+    mocks.setUpLater.mockReset()
+    mocks.dismissOnboarding.mockReset()
+    mocks.back.mockReset()
+    mocks.jumpToStep.mockReset()
+  })
+
+  afterEach(cleanup)
+
+  it('uses Porpita brand fallbacks and Button primitives, moves focus in on mount, and restores focus on close', async () => {
+    const opener = document.createElement('button')
+    opener.textContent = 'Open onboarding'
+    document.body.appendChild(opener)
+    opener.focus()
+    expect(document.activeElement).toBe(opener)
+
+    try {
+      const view = render(
+        <OnboardingFlow onboarding={OPEN_ONBOARDING} onOnboardingChange={vi.fn()} />
+      )
+
+      const dialog = screen.getByRole('dialog', { name: 'Porpita onboarding' })
+      expect(dialog).toBeInTheDocument()
+      expect(screen.getByText('Porpita')).toBeInTheDocument()
+      expect(screen.queryByText(/Orca/)).not.toBeInTheDocument()
+
+      await waitFor(() => {
+        expect(dialog.contains(document.activeElement)).toBe(true)
+      })
+
+      const continueButton = screen.getByRole('button', { name: /Continue/i })
+      expect(continueButton).toHaveAttribute('data-slot', 'button')
+      expect(screen.getByRole('button', { name: 'Set up later' })).toHaveAttribute(
+        'data-slot',
+        'button'
+      )
+
+      // Tabbing from the dialog remains trapped within OnboardingFlow instead of leaking to opener.
+      const user = userEvent.setup()
+      for (let i = 0; i < 8; i += 1) {
+        await user.tab()
+        expect(dialog.contains(document.activeElement)).toBe(true)
+      }
+
+      view.unmount()
+      await waitFor(() => {
+        expect(document.activeElement).toBe(opener)
+      })
+    } finally {
+      opener.remove()
+    }
+  })
+
+  it('renders ThemeModeTiles with single-column narrow breakpoint and Porpita mode buttons', () => {
+    const { container } = render(<ThemeModeTiles value="system" onChange={vi.fn()} />)
+
+    const grid = container.firstElementChild
+    expect(grid).toHaveClass('grid-cols-1', 'sm:grid-cols-3')
+    const modeButtons = screen.getAllByRole('button')
+    expect(modeButtons).toHaveLength(3)
+    expect(modeButtons[0]).toHaveAttribute('aria-pressed', 'true')
+    expect(modeButtons[1]).toHaveAttribute('aria-pressed', 'false')
+    expect(modeButtons[2]).toHaveAttribute('aria-pressed', 'false')
+    for (const button of modeButtons) {
+      expect(button).toHaveAttribute('type', 'button')
+    }
+  })
+})
