{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-collaboration:proposed:command:2.0-draft",
  "title": "Proposed mutation command envelope",
  "$comment": "principal/tenant identity must be derived or verified from authenticated context. grant_ref is not a bearer grant. Payload hash comparison, unique keys, CAS revisions and real authorization must be enforced transactionally.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0-draft"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "command_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authority_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authority_incarnation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "principal_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "grant_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "id",
        "expected_revision"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "command_type",
    "idempotency_key",
    "tenant_id",
    "authority_id",
    "authority_incarnation",
    "principal_ref",
    "grant_ref",
    "target",
    "issued_at",
    "deadline",
    "payload"
  ]
}
