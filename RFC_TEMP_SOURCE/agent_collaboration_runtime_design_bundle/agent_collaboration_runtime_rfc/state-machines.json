    {
      "object": "HarnessSessionBinding",
      "initial": "unbound",
      "states": [
        "unbound",
        "binding",
        "attached",
        "detached",
        "unavailable",
        "retired"
      ],
      "terminal_states": [
        "retired"
      ],
      "note": "A provider session may itself be stored durably. It remains replaceable and distinct from Root / Route / Task.",
      "transitions": [
        {
          "from": "unbound",
          "to": "binding",
          "guard": "target_address_identified",
          "effect_contract": "verify_provider_reference",
          "initiated_by": "authenticated_external_principal",
          "lineage_mode": "external_command",
          "required_command_type": "runtime.bind_or_attach"
        },
