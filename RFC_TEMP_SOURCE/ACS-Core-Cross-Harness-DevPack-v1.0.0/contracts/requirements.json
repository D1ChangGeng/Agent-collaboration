    {
      "id": "R-018",
      "statement": "rebind 不改变历史作者/请求/消息；旧 epoch 回执保留历史证据但不允许旧实例接收新操作。",
      "normative_doc": "docs/03_CORRECTNESS_CONTRACT.md",
