{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acs:receiver-evidence:1",
  "$defs": {
    "Capability": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "support": {
                "const": "supported"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ref": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "support": {
                "const": "supported"
              }
            }
          }
        }
      ],
      "properties": {
        "name": {
          "enum": [
            "native.structured_input",
            "native.operation_lookup",
            "native.idempotency",
            "native.safe_busy_enqueue",
            "native.safe_steer",
            "native.session_resume",
            "native.receiver_prepare",
            "native.input_consumed",
            "native.observe_stream",
            "native.transcript_read",
            "native.approval_roundtrip",
            "native.attachment_delivery",
            "native.terminal_pointer",
            "native.rebind_fence"
          ],
          "title": "Name",
          "type": "string"
        },
        "support": {
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ],
          "title": "Support",
          "type": "string"
        },
        "availability": {
          "enum": [
            "available",
            "temporarily_unavailable",
            "unknown"
          ],
          "title": "Availability",
          "type": "string"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Ref"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valid Until"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "name",
        "support",
        "availability",
        "evidence_ref",
        "valid_until",
        "conditions"
      ],
      "title": "Capability",
      "type": "object"
    },
    "CapabilityScope": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "harness_kind": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Harness Kind",
          "type": "string"
        },
        "harness_version": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Harness Version"
        },
        "execution_host_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Execution Host Ref",
          "type": "string"
        },
        "binary_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Binary Digest"
        },
        "config_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Config Digest"
        },
        "connection_epoch": {
          "minimum": 0,
          "title": "Connection Epoch",
          "type": "integer"
        },
        "provider_generation": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Generation"
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "harness_kind",
        "harness_version",
        "execution_host_ref",
        "binary_digest",
        "config_digest",
        "connection_epoch",
        "provider_generation"
      ],
      "title": "CapabilityScope",
      "type": "object"
    },
    "NativeAdmissionCommand": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "acs-adapter/1",
          "title": "Schema Version",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "receiver_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Receiver Id",
          "type": "string"
        },
        "message_handles": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Message Handles",
          "type": "array",
          "uniqueItems": true
        },
        "canonical_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Hash",
          "type": "string"
        },
        "binding_epoch": {
          "minimum": 0,
          "title": "Binding Epoch",
          "type": "integer"
        },
        "provider_generation": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Generation"
        },
        "auth_revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Auth Revision",
          "type": "string"
        },
        "input_mode": {
          "enum": [
            "structured",
            "safe_queue",
            "terminal_pointer"
          ],
          "title": "Input Mode",
          "type": "string"
        },
        "sealed_envelope": {
          "$ref": "#/$defs/SealedEnvelope"
        },
        "deadline": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deadline"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "receiver_id",
        "message_handles",
        "canonical_hash",
        "binding_epoch",
        "provider_generation",
        "auth_revision",
        "input_mode",
        "sealed_envelope",
        "deadline"
      ],
      "title": "NativeAdmissionCommand",
      "type": "object"
    },
    "NativeAdmissionResult": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "accepted",
                  "queued",
                  "definitively_not_admitted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ref": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "unsupported",
                  "definitively_not_admitted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "effect_possible": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "accepted",
                  "queued",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "effect_possible": {
                "const": true
              }
            }
          }
        }
      ],
      "properties": {
        "schema_version": {
          "const": "acs-adapter/1",
          "title": "Schema Version",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "accepted",
            "queued",
            "definitively_not_admitted",
            "unknown",
            "unsupported"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "effect_possible": {
          "title": "Effect Possible",
          "type": "boolean"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Ref"
        },
        "native_input_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Native Input Ref"
        },
        "binding_epoch": {
          "minimum": 0,
          "title": "Binding Epoch",
          "type": "integer"
        },
        "provider_generation": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Generation"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "outcome",
        "effect_possible",
        "evidence_ref",
        "native_input_ref",
        "binding_epoch",
        "provider_generation",
        "reason_code"
      ],
      "title": "NativeAdmissionResult",
      "type": "object"
    },
    "NativeHandoffContext": {
      "additionalProperties": false,
      "description": "Internal evidence bound into the existing Driver operation transaction.",
      "properties": {
        "schema_version": {
          "const": "acs-native-handoff/1",
          "title": "Schema Version",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "command_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Command Id",
          "type": "string"
        },
        "message_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "message_handle": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message Handle",
          "type": "string"
        },
        "receiver_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Receiver Id",
          "type": "string"
        },
        "actor_address": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Actor Address",
          "type": "string"
        },
        "authority_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Authority Id",
          "type": "string"
        },
        "authority_incarnation": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Authority Incarnation",
          "type": "string"
        },
        "binding_epoch": {
          "minimum": 0,
          "title": "Binding Epoch",
          "type": "integer"
        },
        "provider_generation": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Provider Generation",
          "type": "string"
        },
        "native_session_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Native Session Ref",
          "type": "string"
        },
        "driver_binding_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Driver Binding Id",
          "type": "string"
        },
        "canonical_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Hash",
          "type": "string"
        },
        "input_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "selection_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selection Digest",
          "type": "string"
        },
        "auth_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Auth Revision",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "command_id",
        "message_id",
        "message_handle",
        "receiver_id",
        "actor_address",
        "authority_id",
        "authority_incarnation",
        "binding_epoch",
        "provider_generation",
        "native_session_ref",
        "driver_binding_id",
        "canonical_hash",
        "input_digest",
        "selection_digest",
        "auth_revision"
      ],
      "title": "NativeHandoffContext",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "knowledge": {
                "enum": [
                  "unknown",
                  "unsupported"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "knowledge": {
                "enum": [
                  "observed",
                  "inferred"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              },
              "observed_at": {
                "format": "date-time",
                "type": "string"
              },
              "evidence_ref": {
                "minLength": 1,
                "type": "string"
              },
              "source": {
                "not": {
                  "const": "none"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "pty_heuristic"
              }
            }
          },
          "then": {
            "properties": {
              "knowledge": {
                "const": "inferred"
              }
            }
          }
        }
      ],
      "properties": {
        "knowledge": {
          "enum": [
            "observed",
            "inferred",
            "unknown",
            "unsupported"
          ],
          "title": "Knowledge",
          "type": "string"
        },
        "axis": {
          "enum": [
            "connection",
            "process",
            "session",
            "input",
            "blocker"
          ],
          "title": "Axis",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "source": {
          "enum": [
            "authority",
            "native_api",
            "authenticated_hook",
            "pty_heuristic",
            "none"
          ],
          "title": "Source",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed At"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "binding_epoch": {
          "minimum": 0,
          "title": "Binding Epoch",
          "type": "integer"
        },
        "provider_generation": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Generation"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Ref"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        }
      },
      "required": [
        "knowledge",
        "axis",
        "value",
        "source",
        "observed_at",
        "expires_at",
        "binding_epoch",
        "provider_generation",
        "evidence_ref",
        "reason_code"
      ],
      "title": "Observation",
      "type": "object"
    },
    "ReceiverSnapshot": {
      "additionalProperties": false,
      "properties": {
        "receiver_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Receiver Id",
          "type": "string"
        },
        "address": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Address",
          "type": "string"
        },
        "binding_epoch": {
          "minimum": 0,
          "title": "Binding Epoch",
          "type": "integer"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "native_session_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Native Session Ref"
        },
        "capability_scope": {
          "$ref": "#/$defs/CapabilityScope"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "maxItems": 14,
          "title": "Capabilities",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 5,
          "title": "Observations",
          "type": "array"
        },
        "allowed_actions": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Allowed Actions",
          "type": "array"
        }
      },
      "required": [
        "receiver_id",
        "address",
        "binding_epoch",
        "revision",
        "native_session_ref",
        "capability_scope",
        "capabilities",
        "observations",
        "allowed_actions"
      ],
      "title": "ReceiverSnapshot",
      "type": "object"
    },
    "SealedEnvelope": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "encoding": {
          "const": "base64",
          "title": "Encoding",
          "type": "string"
        },
        "data": {
          "maxLength": 2097152,
          "minLength": 1,
          "title": "Data",
          "type": "string"
        }
      },
      "required": [
        "format",
        "encoding",
        "data"
      ],
      "title": "SealedEnvelope",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/ReceiverSnapshot"
    },
    {
      "$ref": "#/$defs/NativeAdmissionCommand"
    },
    {
      "$ref": "#/$defs/NativeAdmissionResult"
    },
    {
      "$ref": "#/$defs/NativeHandoffContext"
    }
  ]
}
