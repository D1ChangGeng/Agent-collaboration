{
  "schema_version": "acs-p2-mcp-tool-contract/4",
  "surface_revision": "acs-p2-mcp-workflow/4",
  "server": "agent-collaboration-runtime",
  "naming_convention": "concise_action_phrase",
  "naming_principles": [
    "intended_action",
    "human_collaboration_phrase",
    "runtime_or_domain_behavior",
    "list_for_enumeration",
    "target_as_argument_when_contract_is_uniform",
    "separate_tool_when_authorization_state_or_result_differs"
  ],
  "advanced_tools": [
    "submit_command"
  ],
  "compatibility_aliases": {
    "run": {
      "canonical_tool": "submit_command",
      "exposure": "advanced_compatibility",
      "removal_condition": "all admitted clients use submit_command"
    }
  },
  "defaults": {
    "activation": "invoke",
    "delivery_policy": "queue_until_idle",
    "expect_response": true,
    "response_mode": "async",
    "wait_until": "response_received",
    "list_limit": 50,
    "max_inline_bytes": 16384
  },
  "receipt_order": [
    "accepted_by_authority",
    "target_inbox_committed",
    "runtime_dispatched",
    "runtime_acknowledged",
    "response_received"
  ],
  "tool_result_transport": {
    "content": "one concise text summary for the calling Agent",
    "structuredContent": "one acs-mcp-result/3 success or problem envelope",
    "isError": "false for accepted observations and state transitions; true for rejected or failed tool execution"
  },
  "tools": {
    "read_profile": {
      "title": "Read connection profile",
      "description": "Read the authenticated subject, tenant, granted profiles, connection state and OAuth scope summary.",
      "selection_guidance": "Use at the start of a global or web session.",
